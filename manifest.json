{
  "manifest_version": 3,
  "name": "Mentari Mod v2.0",
  "version": "2.1.0",
  "description": "Ekstensi modern untuk meningkatkan pengalaman belajar di MENTARI UNPAM dengan asisten AI Gemini generasi baru, anti-deteksi, dan manajemen presensi.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://mentari.unpam.ac.id/*",
    "https://my.unpam.ac.id/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_icon": "dist/assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mentari.unpam.ac.id/*",
        "https://my.unpam.ac.id/*"
      ],
      "js": [
        "dist/content/main-sniffer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/*",
        "https://my.unpam.ac.id/*"
      ],
      "js": [
        "dist/content/apiKeyManager.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/*"
      ],
      "exclude_matches": [
        "https://mentari.unpam.ac.id/login"
      ],
      "js": [
        "dist/content/gemini.js",
        "dist/content/token.js",
        "dist/content/content.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/login"
      ],
      "js": [
        "dist/content/home.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/exam/*"
      ],
      "js": [
        "dist/content/quiz.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/kuesioner/*",
        "https://mentari.unpam.ac.id/u-courses/*/kuisioner/*"
      ],
      "js": [
        "dist/content/kuisioner.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/forum/*/topics/*"
      ],
      "js": [
        "dist/content/discus.js"
      ]
    },
    {
      "matches": [
        "https://my.unpam.ac.id/*"
      ],
      "exclude_matches": [
        "https://mentari.unpam.ac.id/login"
      ],
      "js": [
        "dist/content/presensi.js",
        "dist/content/QuickSurvey.js"
      ]
    },
    {
      "matches": [
        "https://my.unpam.ac.id/login",
        "https://mentari.unpam.ac.id/login"
      ],
      "js": [
        "dist/content/pw.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content/main-sniffer.js",
        "dist/content/token.js",
        "dist/content/apiKeyManager.js",
        "dist/assets/background.png"
      ],
      "matches": [
        "https://mentari.unpam.ac.id/*",
        "https://my.unpam.ac.id/*"
      ]
    }
  ],
  "icons": {
    "16": "dist/assets/icon.png",
    "48": "dist/assets/icon.png",
    "128": "dist/assets/icon.png"
  }
}